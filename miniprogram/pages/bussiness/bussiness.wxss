.text{

  font-weight: 500;
  color: #1b9fa8;
  font-size: 40rpx;
}
.container {
  padding: 20rpx;
  background-color: rgb(255, 255, 255);
}
.title{
  font-weight: bolder;
}
.content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* 最多显示两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  word-wrap: break-word;
  white-space: normal;
  font-size: 32rpx; /* 默认字号 */
}
.note {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #3ecbee;
  transition: transform 0.05s ease;
}
.note.active {
  transform: scale(0.9);
}
.create-time {
  font-size: 24rpx; 
  color: #888; 
  text-align: right; 
  margin-top: 10rpx; 
}
