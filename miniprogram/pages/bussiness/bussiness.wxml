<view class="container">
  <view class="text">{{data}}</view>
  <block wx:for="{{notes}}" wx:key="index">
    <view class="note {{item.activeClass}}" 
          style="width: 300px; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word;" 
          bind:tap="navigateToAddOrEdit" 
          data-id="{{item.id}}" 
          data-index="{{index}}">
      <text class="title">{{item.title}}</text>
      <text>\n</text>
      <text class="content">{{item.content}}</text>
      <view class="create-time">{{item.createTime}}</view>
    </view>
  </block>
  <button bind:tap="navigateToAddOrEdit">+</button>
</view>